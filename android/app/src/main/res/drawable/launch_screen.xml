<?xml version="1.0" encoding="utf-8"?>
<!-- Launch window before React Native draws (Android 7–11). Android 12+ uses values-v31/styles.xml.
     The JS splash (src/components/SplashScreen.tsx) starts with the logo in this same spot. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android" android:opacity="opaque">
    <item android:drawable="@color/splash_background" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/splash_logo" />
    </item>
</layer-list>
